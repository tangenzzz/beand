---
import Base from '../layouts/Base.astro';
import PhoneHome from './PhoneHome.astro';
import ShotTiles from './ShotTiles.astro';
import ShotHistory from './ShotHistory.astro';
import CoffeeDesk from './CoffeeDesk.astro';
import Points from './Points.astro';
import { home as c } from '../i18n/home';
import { release } from '../release';
---
<Base lang="en" route="home">
  <section class="hero wrap">
    <h1>{c.hero.title}</h1>
    <p class="lead">{c.hero.lead}</p>
    <p class="note">{c.hero.note}</p>
    <div class="download">
      <a href={release.url} rel="noopener">Download on GitHub <span aria-hidden="true">›</span></a>
      <p>Google Play and App Store coming soon. Latest release {release.version}</p>
    </div>
  </section>

  <ShotTiles />

  <section id="machine" class="wrap story">
    <div class="text">
      <p class="eyebrow">{c.machine.eyebrow}</p>
      <h2>{c.machine.title}</h2>
      <p class="body">{c.machine.body}</p>
      <Points items={c.machine.points} />
    </div>
    <div class="phones"><PhoneHome /></div>
  </section>

  <ShotHistory />

  <CoffeeDesk />

  <section id="equipment" class="wrap equipment">
    <p class="eyebrow">Compatibility</p>
    <h2>Supported equipment</h2>
    <dl class="eq">
      <div><dt>Machines</dt><dd>Meticulous Espresso, GaggiMate</dd></div>
      <div><dt>Scales</dt><dd>Acaia, Decent, Bookoo</dd></div>
    </dl>
    <div class="meta">
      <div>
        <h3>Latest release</h3>
        <p class="version"><a href={release.url} rel="noopener">{release.version}</a></p>
      </div>
      <div>
        <h3>Roadmap</h3>
        <ul><li>Integrate Pressensor</li><li>Integrate Espresso Home Pill</li><li>More Bluetooth scales</li><li>Statistics</li></ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: big headline, lead, download as a text link */
  .hero { padding: 6rem 0 2rem; }
  .hero h1 { font-size: clamp(3.4rem, 10vw, 8.5rem); max-width: 10ch; }
  .lead { margin: 1.75rem 0 0.8rem; }
  .note { margin: 0.4rem 0 0; font-size: 0.9rem; color: var(--text-muted); }
  .download { margin-top: 2rem; }
  .download a { color: var(--accent); font-size: 1.3rem; font-weight: 500; letter-spacing: -0.015em; text-decoration: none; }
  .download a:hover { text-decoration: underline; }
  .download p { margin: 0.5rem 0 0; color: var(--text-muted); font-size: 0.95rem; }
  @media (max-width: 900px) { .hero { padding-top: 3.5rem; } }

  /* Machine section: phone left, text right */
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; align-items: center; padding-top: 8rem; }
  .story .text { order: 2; }
  .story h2 { max-width: 16ch; }
  .phones { display: flex; justify-content: center; }
  @media (max-width: 820px) {
    .story { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 5rem; }
    .story .text { order: 0; }
  }

  /* Supported equipment: spec-sheet look */
  .equipment { padding-top: 8rem; }
  .eq { margin: 2rem 0 0; max-width: 760px; }
  .eq > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid #2c2c2e; }
  .eq > div:last-child { border-bottom: 1px solid #2c2c2e; }
  .eq dt { color: var(--text-muted); font-size: 0.85rem; }
  .eq dd { margin: 0; font-weight: 600; font-size: 1rem; letter-spacing: -0.012em; }
  .meta { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; margin-top: 2.25rem; max-width: 760px; }
  .meta > div { display: contents; }
  .meta h3 { font-size: 0.85rem; font-weight: 400; color: var(--text-muted); margin: 0; padding-top: 0.15rem; }
  .version { margin: 0; font-size: 1rem; font-weight: 600; letter-spacing: -0.012em; font-variant-numeric: tabular-nums; }
  .version a { color: var(--text); text-decoration: none; }
  .version a:hover { color: var(--accent); }
  .meta ul { list-style: none; margin: 0; padding: 0; }
  .meta li { font-size: 1rem; font-weight: 600; letter-spacing: -0.012em; margin-bottom: 0.25rem; }
</style>
