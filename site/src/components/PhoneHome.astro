---
// The app's home tab as one "screenshot": the top (mode chips, hero ring, sensors) is rebuilt
// live, everything below is the real screenshot. Switching mode swaps the home tab, like in the app.
// Sizes are in cqw of the phone width, measured on 960 px wide screenshots (1 cqw = 9.6 px).
//
// Ring: inner = preheat, outer = stabilised (Meticulous). Pour-over: ring = progress of the
// current pour, inside the flow gauge (240°, ideal 5 g/s at the top, green ±1.5, yellow ±3, red
// beyond — lib/models/brew_plan.dart). Plays once when scrolled into view and on every switch.
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';

const R = 100;
const DR = 72, SWEEP = 240, START = -90 - SWEEP / 2, FLOW_MAX = 10;
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [120 + r * Math.cos(a), 120 + r * Math.sin(a)];
};
const arc = (from: number, to: number, r: number) => {
  const a = START + (from / FLOW_MAX) * SWEEP + 1.2;
  const b = START + (to / FLOW_MAX) * SWEEP - 1.2;
  const [x1, y1] = pt(a, r), [x2, y2] = pt(b, r);
  return `M${x1.toFixed(2)} ${y1.toFixed(2)} A${r} ${r} 0 ${b - a > 180 ? 1 : 0} 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};
const zones = [
  [0, 2, '#e5534b'], [2, 3.5, '#e3b341'], [3.5, 6.5, '#3fb950'], [6.5, 8, '#e3b341'], [8, 10, '#e5534b'],
] as const;
const lenO = 2 * Math.PI * (R + 2.5), lenI = 2 * Math.PI * (R - 2.5);
---
<figure class="phone-home" data-home data-mode="espresso">
  <div class="mode-dots" role="group" aria-label="Choose a home tab">
    <button type="button" data-mode-dot="espresso" aria-current="true" aria-label="Meticulous"><i></i></button>
    <button type="button" data-mode-dot="gaggimate" aria-label="GaggiMate"><i></i></button>
    <button type="button" data-mode-dot="pourover" aria-label="Pour Over"><i></i></button>
  </div>
  <div class="screen" data-swipe>
    <div class="live">
      <div class="chips" role="group" aria-label="Home tab">
        <button type="button" data-mode-btn="espresso" aria-pressed="true">Meticulous <i class="dot"></i></button>
        <button type="button" data-mode-btn="gaggimate" aria-pressed="false" class="gm-chip">GAGGIMATE <i class="dot"></i></button>
        <button type="button" data-mode-btn="pourover" aria-pressed="false">Pour Over
          <svg class="bt" viewBox="0 0 12 18" aria-hidden="true"><path d="M2 5l8 8-4 4V1l4 4-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <svg class="gear" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.4-2.5.1-1-.1-1 2.1-1.6-2-3.5-2.5 1a7 7 0 0 0-1.7-1l-.4-2.6h-4l-.4 2.6a7 7 0 0 0-1.7 1l-2.5-1-2 3.5L4.5 11l-.1 1 .1 1-2.1 1.6 2 3.5 2.5-1c.5.4 1.1.8 1.7 1l.4 2.6h4l.4-2.6c.6-.2 1.2-.6 1.7-1l2.5 1 2-3.5Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </div>

      <svg viewBox="0 0 240 240" class="dial" aria-hidden="true">
        <circle cx="120" cy="120" r={R + 2.5} class="track" stroke-width="5" />
        <circle cx="120" cy="120" r={R - 2.5} class="track" stroke-width="5" />
        <circle cx="120" cy="120" r={R + 2.5} class="prog" data-outer stroke-width="5" stroke-dasharray={lenO} stroke-dashoffset={lenO} transform="rotate(-90 120 120)" />
        <circle cx="120" cy="120" r={R - 2.5} class="prog" data-inner stroke-width="5" stroke-dasharray={lenI} stroke-dashoffset={lenI} transform="rotate(-90 120 120)" />
        <g data-gauge class="gauge">
          {zones.map(([a, b, c]) => <path d={arc(a, b, DR)} stroke={c} stroke-width="9" fill="none" />)}
          <line x1="120" y1="120" x2="120" y2={120 - DR + 10} class="needle" data-needle />
          <circle cx="120" cy="120" r="4.5" class="hub" />
        </g>
      </svg>

      <div class="center esp">
        <span class="big" data-temp>45.0°</span>
        <span class="target"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1v10M2.5 1.5h7l-1.5 2.2L9.5 6h-7" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>82.0°</span>
        <span class="status" data-status>~3:10</span>
      </div>
      <div class="center po"><span class="flow"><b data-flow>0.0</b> g/s</span></div>
      <div class="center gm">
        <span class="big">92.0°</span>
        <span class="target"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1v10M2.5 1.5h7l-1.5 2.2L9.5 6h-7" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>91.0°</span>
      </div>

      <dl class="side esp">
        <div style="--c:#f0914a"><dt>UP</dt><dd data-s="0">45.0°</dd></div>
        <div style="--c:#f2c94c"><dt>MID</dt><dd data-s="1">48.2°</dd></div>
        <div style="--c:#4aa8f0"><dt>DOWN</dt><dd data-s="2">47.1°</dd></div>
        <div style="--c:#a98be8"><dt>GROUP HEAD</dt><dd data-s="3">38.4°</dd></div>
      </dl>
      <dl class="side gm">
        <div style="--c:#5bd68a"><dt>BAR</dt><dd data-gm="bar">0.0</dd></div>
        <div style="--c:#4fb3f0"><dt>ML/S</dt><dd data-gm="flow">0.0</dd></div>
        <div style="--c:#f2c94c"><dt>G</dt><dd data-gm="g">0.0</dd></div>
      </dl>
      <dl class="side po">
        <div style="--c:#f3eee4"><dt>TIME</dt><dd data-time>0:00</dd></div>
        <div style="--c:#f2c94c"><dt>G</dt><dd data-weight>0.0</dd></div>
      </dl>
      <p class="pour po" data-pour>READY · Bloom · 25 g</p>

      <svg class="trend esp" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>

    <img class="shot esp" src="/screens/home-esp-controls.webp" width="960" height="226" alt="Meticulous controls: preheat, scale, purge, raise" />
    <img class="shot gm" src="/screens/home-gm-controls.webp" width="960" height="226" alt="GaggiMate controls: brew, steam, water, flush" loading="lazy" />
    <img class="shot po" src="/screens/home-po-controls.webp" width="960" height="233" alt="Pour-over controls: profile, tare, scale, battery" loading="lazy" />
  </div>
</figure>

<style>
  .phone-home { margin: 0; width: min(360px, 100%); }
  /* Dots above the phone: the three home tabs, also reachable by swiping the screen */
  .mode-dots { display: flex; justify-content: center; gap: 0.15rem; margin-bottom: 0.9rem; }
  .mode-dots button { display: inline-flex; padding: 7.5px; border: 0; background: none; cursor: pointer; }
  .mode-dots i { width: 9px; height: 9px; border-radius: 50%; background: #55504a; }
  .mode-dots button[aria-current] i { background: var(--accent); }
  .mode-dots button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  .screen { touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .screen {
    container-type: inline-size;
    background: #1b1b1d; border: 1px solid var(--line); border-radius: 28px; overflow: hidden;
    font-family: 'Roboto', system-ui, sans-serif; color: #e8e6e3;
    font-variant-numeric: tabular-nums;
  }
  .shot { display: block; width: 100%; height: auto; }
  [data-mode='espresso'] :is(.po, .gm), [data-mode='pourover'] :is(.esp, .gm), [data-mode='gaggimate'] :is(.esp, .po) { display: none !important; }

  /* Live top part: 960 × 670 px in the screenshot */
  .live { position: relative; height: 69.8cqw; }

  .chips { position: absolute; left: 3.85cqw; right: 3.6cqw; top: 5.7cqw; display: flex; align-items: center; gap: 2.1cqw; }
  .chips button {
    display: inline-flex; align-items: center; gap: 1.6cqw; height: 5.8cqw; padding: 0 2.6cqw;
    font: 400 2.75cqw 'Roboto', sans-serif; color: #9a9a9e; background: none;
    border: 0.21cqw solid #4a4a4e; border-radius: 3cqw; cursor: pointer;
  }
  .chips button[aria-pressed='true'] { color: #f2f2f2; border-color: #8a8a8e; }
  .chips { gap: 1.6cqw; }
  .chips button { padding: 0 2.2cqw; }
  .gm-chip { letter-spacing: 0.08em; font-weight: 300 !important; }
  .chips button:not([aria-pressed='true']) .dot { background: #5a554f; }
  .dot { width: 1.25cqw; height: 1.25cqw; border-radius: 50%; background: #5ad16a; }
  .bt { width: 1.5cqw; color: #4aa8f0; }
  [data-mode='espresso'] .bt { color: #e5534b; }
  .gear { width: 4.4cqw; margin-left: auto; color: #9a9a9e; }

  .dial { position: absolute; left: 13cqw; top: 14.1cqw; width: 45.2cqw; height: auto; }
  .track { fill: none; stroke: #3f3f43; }
  .prog { fill: none; stroke: #1d9e75; }
  .gauge { opacity: 0; }
  [data-mode='pourover'] .gauge { opacity: 1; }
  .needle { stroke: #d8d2c6; stroke-width: 2.5; stroke-linecap: round; transform-origin: 120px 120px; transform: rotate(-120deg); transition: transform 0.12s linear; }
  .hub { fill: #d8d2c6; }

  .center { position: absolute; left: 13cqw; top: 14.1cqw; width: 45.2cqw; height: 45.2cqw; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
  .big { font-size: 6.8cqw; font-weight: 400; line-height: 1.1; letter-spacing: -0.01em; }
  .target { display: inline-flex; align-items: center; gap: 0.9cqw; color: #9a9a9e; font-size: 2.3cqw; margin-top: 1.4cqw; }
  .target svg { width: 1.9cqw; }
  .status { color: #29c7b0; font-size: 2.7cqw; font-weight: 500; margin-top: 1cqw; min-height: 1.3em; }
  .center.po { justify-content: flex-start; padding-top: 28cqw; }
  .flow { color: #9a9a9e; font-size: 2.2cqw; }
  .flow b { color: #f2f2f2; font-size: 5cqw; font-weight: 400; margin-right: 0.4cqw; }

  .side { position: absolute; left: 62.5cqw; top: 19.3cqw; margin: 0; display: grid; gap: 2.5cqw; }
  .side.po { top: 25cqw; }
  .side.gm { top: 23cqw; gap: 3.2cqw; }
  /* GaggiMate has one sensor, so one solid ring */
  [data-mode='gaggimate'] .track { stroke: #1d9e75; }
  .side div { border-left: 0.65cqw solid var(--c); border-radius: 0.3cqw; padding-left: 2.3cqw; }
  .side dt { color: #9a9a9e; font-size: 2.2cqw; letter-spacing: 0.1em; line-height: 1.3; }
  .side dd { margin: 0; font-size: 3.4cqw; font-weight: 500; line-height: 1.25; }
  .pour { position: absolute; left: 13cqw; width: 45.2cqw; top: 60.5cqw; margin: 0; text-align: center; color: #9a9a9e; font-size: 2.2cqw; letter-spacing: 0.04em; }
  .trend { position: absolute; left: 48.2cqw; top: 60.5cqw; width: 4.4cqw; color: #9a9a9e; transform: translateX(-50%); }

  .chips button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  type Mode = 'espresso' | 'gaggimate' | 'pourover';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-home]')) {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const outer = q<SVGCircleElement>('[data-outer]');
    const inner = q<SVGCircleElement>('[data-inner]');
    const lenO = 2 * Math.PI * outer.r.baseVal.value;
    const lenI = 2 * Math.PI * inner.r.baseVal.value;
    const needle = q<SVGLineElement>('[data-needle]');
    const sensors = [...root.querySelectorAll<HTMLElement>('[data-s]')];
    const el = { temp: q('[data-temp]'), status: q('[data-status]'), flow: q('[data-flow]'), time: q('[data-time]'), weight: q('[data-weight]'), pour: q('[data-pour]') };
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]')];
    let raf = 0;

    const setRing = (c: SVGCircleElement, len: number, p: number) => (c.style.strokeDashoffset = String(len * (1 - Math.max(0, Math.min(1, p)))));
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    // Espresso: preheat to 82° (the profile's target), ETA counts down, then "Stabilizing" → "Stable".
    const TARGET = 82;
    const from = [45, 48.2, 47.1, 38.4], to = [81.6, 83.2, 82.3, 78.3];
    const espresso = (t: number) => {
      const h = ease(Math.min(1, t / 0.7));
      const temp = 45 + (TARGET - 0.7 - 45) * h + (t > 0.7 ? 0.7 * ease((t - 0.7) / 0.3) : 0);
      el.temp.textContent = `${temp.toFixed(1)}°`;
      sensors.forEach((s, i) => (s.textContent = `${(from[i] + (to[i] - from[i]) * h).toFixed(1)}°`));
      setRing(inner, lenI, (temp - 20) / (TARGET - 20));
      setRing(outer, lenO, ease(Math.max(0, (t - 0.7) / 0.3)));
      el.status.textContent = t < 0.7 ? `~${mmss(190 * (1 - h))}` : t < 1 ? 'Stabilizing' : 'Stable ✓';
    };

    // Pour-over: just the bloom, in real time. 25 g poured over 5 s at about 5 g/s:
    // the needle wobbles gently inside the green zone, weight and time count up, the ring fills.
    const BLOOM = 25, POUR_S = 5; // 5 g/s: right in the middle of the green zone
    const wobble = (s: number) => 0.35 * Math.sin(2 * Math.PI * 0.9 * s) + 0.2 * Math.sin(2 * Math.PI * 2.3 * s + 1);
    const flowAt = (s: number) => (BLOOM / POUR_S + wobble(s)) * Math.min(1, s / 0.3); // short ramp as the pour starts
    // Weight = poured so far, normalised so it ends exactly at the bloom target
    const raw = (s: number) => {
      let w = 0;
      for (let x = 0; x < s; x += 0.02) w += flowAt(x) * Math.min(0.02, s - x);
      return w;
    };
    const RAW_END = raw(POUR_S);
    const pourover = (t: number) => {
      const s = t * POUR_S;
      const f = t >= 1 ? 0 : flowAt(s);
      const w = (raw(s) / RAW_END) * BLOOM;
      el.flow.textContent = f.toFixed(1);
      el.time.textContent = mmss(s);
      el.weight.textContent = w.toFixed(1);
      needle.style.transform = `rotate(${-120 + (Math.min(f, 10) / 10) * 240}deg)`;
      setRing(outer, lenO, w / BLOOM);
      setRing(inner, lenI, 0);
      el.pour.textContent = t >= 1 ? `BLOOM DONE · ${BLOOM} g` : `BLOOM · ${Math.round(w)} / ${BLOOM} g`;
    };

    // GaggiMate: the boiler holds 92° (target 91°) while a shot starts:
    // pressure builds through preinfusion to 9 bar, flow settles near 2 ml/s, weight starts to drip in.
    const gm = { bar: q('[data-gm="bar"]'), flow: q('[data-gm="flow"]'), g: q('[data-gm="g"]') };
    const smoothstep = (a: number, b: number, x: number) => { const k = Math.min(1, Math.max(0, (x - a) / (b - a))); return k * k * (3 - 2 * k); };
    const gaggimate = (t: number) => {
      const s = t * 5; // seconds
      const bar = 2.2 * smoothstep(0, 0.8, s) + 6.8 * smoothstep(1.8, 3.6, s) + 0.08 * Math.sin(s * 9) * smoothstep(3.6, 4, s);
      const flow = 4.2 * smoothstep(0, 0.6, s) * (1 - smoothstep(0.8, 2, s)) + 0.6 + 1.5 * smoothstep(2.6, 4.2, s);
      const g = 9 * smoothstep(2.2, 5.6, s);
      gm.bar.textContent = bar.toFixed(1);
      gm.flow.textContent = (s < 0.05 ? 0 : flow).toFixed(1);
      gm.g.textContent = g.toFixed(1);
      setRing(outer, lenO, 1);
      setRing(inner, lenI, 1);
    };

    const play = (mode: Mode) => {
      cancelAnimationFrame(raf);
      root.dataset.mode = mode;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)));
      root.querySelectorAll<HTMLButtonElement>('[data-mode-dot]').forEach((d) => d.toggleAttribute('aria-current', d.dataset.modeDot === mode));
      const frame = mode === 'espresso' ? espresso : mode === 'gaggimate' ? gaggimate : pourover;
      if (reduce) return frame(1);
      const dur = mode === 'espresso' ? 5200 : 5000; // GaggiMate and pour-over: 5 s
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        frame(t);
        if (t < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    // Pills, dots and swiping all switch the home tab; a short slide shows the direction.
    const order: Mode[] = ['espresso', 'gaggimate', 'pourover'];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-mode-dot]')];
    const screen = root.querySelector<HTMLElement>('[data-swipe]')!;
    const switchTo = (mode: Mode) => {
      const from = order.indexOf(root.dataset.mode as Mode), to = order.indexOf(mode);
      if (from === to) return play(mode);
      play(mode);
      if (!reduce) {
        const dir = to > from ? 1 : -1;
        for (const el of screen.querySelectorAll<HTMLElement>('.live, .shot')) {
          el.animate([{ transform: `translateX(${dir * 14}%)`, opacity: 0.2 }, { transform: 'none', opacity: 1 }], { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
        }
      }
    };
    buttons.forEach((b) => b.addEventListener('click', () => switchTo(b.dataset.modeBtn as Mode)));
    dots.forEach((d) => d.addEventListener('click', () => switchTo(d.dataset.modeDot as Mode)));
    let x0 = 0, y0 = 0, tracking = false;
    screen.addEventListener('pointerdown', (e) => { tracking = true; x0 = e.clientX; y0 = e.clientY; });
    screen.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      const i = order.indexOf(root.dataset.mode as Mode) + (dx < 0 ? 1 : -1);
      if (i >= 0 && i < order.length) switchTo(order[i]);
    });
    screen.addEventListener('pointercancel', () => (tracking = false));
    espresso(0);
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play('espresso'); }
    }, { threshold: 0.5 });
    io.observe(root);
  }
</script>
