---
import Base from '../layouts/Base.astro';
import { releases } from '../changelog';

// "2026-11-14" → "14 November 2026"
const nice = (d: string) => {
  const t = Date.parse(d);
  return Number.isNaN(t) ? d : new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
---
<Base lang="en" route="updates" title="Updates" description="What changed in every bean'd release.">
  <section class="wrap updates">
    <p class="eyebrow">Updates</p>
    <h1>What’s new</h1>
    <ol class="timeline">
      {releases.map((r, i) => (
        <li class:list={{ latest: i === 0 }}>
          <div class="when">
            <a class="version" href={r.url} rel="noopener">{r.version}</a>
            {r.date && <time datetime={r.date}>{nice(r.date)}</time>}
          </div>
          <div class="what">
            {r.intro.map((p) => <p class="intro">{p}</p>)}
            {r.groups.map((g) => (
              <div class="group">
                <h2>{g.title}</h2>
                <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .updates { padding: 4rem 0 0; }
  .updates h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); margin-bottom: 3rem; }

  /* Timeline: a line on the left, a dot per release, newest on top */
  .timeline { list-style: none; margin: 0; padding: 0; max-width: 820px; }
  .timeline > li { position: relative; display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; padding: 0 0 3rem 1.75rem; }
  .timeline > li::before { content: ''; position: absolute; left: 0.3rem; top: 0.6rem; bottom: -0.6rem; width: 1px; background: var(--line); }
  .timeline > li:last-child::before { display: none; }
  .timeline > li::after { content: ''; position: absolute; left: 0; top: 0.35rem; width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--text-muted); }
  .timeline > li.latest::after { background: var(--accent); box-shadow: 0 0 0 4px rgba(41, 199, 176, 0.18); }

  .when { display: flex; flex-direction: column; gap: 0.2rem; }
  .version { color: var(--text); font-size: 1.3rem; font-weight: 700; letter-spacing: -0.015em; text-decoration: none; font-variant-numeric: tabular-nums; }
  .version:hover { color: var(--accent); }
  .when time { color: var(--text-muted); font-size: 0.85rem; }

  .what .intro { margin: 0.15rem 0 0.8rem; }
  .group + .group { margin-top: 1.1rem; }
  .group h2 { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 0.25rem 0 0.4rem; }
  .group ul { margin: 0; padding-left: 1.1rem; }
  .group li { margin-bottom: 0.35rem; line-height: 1.45; }

  @media (max-width: 700px) {
    .timeline > li { grid-template-columns: 1fr; gap: 0.6rem; }
  }
</style>
